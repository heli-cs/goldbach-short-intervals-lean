Command: lake --packages=.lake/explicit-cache.json env lean .lake/vynohradov-interface-check.lean
The two GoldbachRH definitions below were extracted from the identical source bodies at both pinned tags.

import Goldbach.Explicit.FiniteRange

namespace GoldbachRH
def IsGoldbachNumber (n : ℕ) : Prop :=
  Even n ∧ ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ p + q = n
def GoldbachVerifiedUpTo (N : ℕ) : Prop :=
  ∀ n : ℕ, Even n → 4 < n → n ≤ N → IsGoldbachNumber n
end GoldbachRH


/-- The finite-computation input in v0.5 is precisely inclusive bounded even Goldbach. -/
theorem vynohradov_finite_input_iff :
    GoldbachRH.GoldbachVerifiedUpTo (4 * 10^18) ↔
      ∀ n : ℕ, 6 ≤ n → n ≤ 4 * 10^18 → Even n →
        ∃ p q : ℕ, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n := by
  constructor
  · intro h n hn hb he
    exact (h n he (by omega) hb).2
  · intro h n he hn hb
    have hn6 : 6 ≤ n := by
      obtain ⟨k, hk⟩ := he
      omega
    exact ⟨he, h n hn6 hb he⟩

/-- The upstream certificate input supplies the current project's finite premise. -/
theorem current_finite_input_of_vynohradov
    (h : GoldbachRH.GoldbachVerifiedUpTo (4 * 10^18)) :
    FiniteGoldbachExplicitRange := by
  apply finiteGoldbachExplicitRange_of_prime_representations
  intro n hn hb he
  have hbound : n ≤ (4000000000000000000 : ℕ) := hb.le
  have hb' : n ≤ 4 * 10^18 := by
    norm_num
    exact hbound
  exact (vynohradov_finite_input_iff.mp h) n hn hb' he

example (hRH : RiemannHypothesis)
    (h : GoldbachRH.GoldbachVerifiedUpTo (4 * 10^18)) :
    ∀ x : ℝ, 5 ≤ x →
      ∃ p q : ℕ, Nat.Prime p ∧ Nat.Prime q ∧ Odd p ∧ Odd q ∧
        x < (p : ℝ) + (q : ℝ) ∧
        (p : ℝ) + (q : ℝ) ≤ x + (Real.log x)^2 :=
  goldbach_short_interval_explicit_of_finite hRH (current_finite_input_of_vynohradov h)

theorem current_analytic_cutoff_lt_vynohradov : Real.exp 42 < (3900000000000000000 : ℝ) := by
  have he : Real.exp 1 ≤ (272 / 100 : ℝ) := by linarith [Real.exp_one_lt_d9]
  calc
    Real.exp 42 = (Real.exp 1)^42 := by rw [← Real.exp_nat_mul]; norm_num
    _ ≤ (272 / 100 : ℝ)^42 := pow_le_pow_left₀ (Real.exp_pos 1).le he 42
    _ < 3900000000000000000 := by norm_num

#print GoldbachRH.GoldbachVerifiedUpTo
#check @vynohradov_finite_input_iff
#check @current_finite_input_of_vynohradov
#check @current_analytic_cutoff_lt_vynohradov
#print axioms vynohradov_finite_input_iff
#print axioms current_finite_input_of_vynohradov
#print axioms current_analytic_cutoff_lt_vynohradov

def GoldbachRH.GoldbachVerifiedUpTo : ℕ → Prop :=
fun N => ∀ (n : ℕ), Even n → 4 < n → n ≤ N → GoldbachRH.IsGoldbachNumber n
vynohradov_finite_input_iff : GoldbachRH.GoldbachVerifiedUpTo (4 * 10 ^ 18) ↔
  ∀ (n : ℕ), 6 ≤ n → n ≤ 4 * 10 ^ 18 → Even n → ∃ p q, Nat.Prime p ∧ Nat.Prime q ∧ p + q = n
current_finite_input_of_vynohradov : GoldbachRH.GoldbachVerifiedUpTo (4 * 10 ^ 18) → FiniteGoldbachExplicitRange
current_analytic_cutoff_lt_vynohradov : Real.exp 42 < 3900000000000000000
'vynohradov_finite_input_iff' depends on axioms: [propext, Quot.sound]
'current_finite_input_of_vynohradov' depends on axioms: [propext, Classical.choice, Quot.sound]
